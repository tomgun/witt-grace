{
  "permissions": {
    "allow": [
      "Bash(npm run check*)",
      "Bash(npm run proto:*)",
      "Bash(npm test*)",
      "Bash(npm run lint*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run format*)",
      "Bash(node scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./tmp-ref/**/.env)",
      "Read(./tmp-ref/**/.env.*)",
      "Bash(git push --force*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/run.sh \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/protect-files.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/run.sh \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard-bash.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
