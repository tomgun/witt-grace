{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:witt:project:v5",
  "title": "WITT project v5: semantic claims, independent feasibility and portable four-way layout",
  "description": "WITT project v5: fact/value semantics, relationship influence, optional local vote round with snapshotted weights. Legacy valueAssessments are preserved but are no longer a user-facing rating axis. Closed local voting rounds are archived in voteHistory without resetting their ballots. The optional sharedReasons catalog holds locked project-wide reason templates with explicit scored primary-leaf uses. Additive dev.19 extension: option-group structural nodes and contextual reason concepts; heuristic-v1 unchanged. Dev.20 adds optional assessmentWeighting (structural, equal, shares) without changing the heuristic formula.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "mode",
    "theme",
    "settings",
    "users",
    "nodes",
    "comments",
    "votes",
    "ballots",
    "createdAt",
    "updatedAt",
    "links",
    "edgeAssessments",
    "layout"
  ],
  "properties": {
    "schemaVersion": {
      "const": 5
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "$ref": "#/$defs/title"
    },
    "mode": {
      "enum": [
        "argument",
        "decision"
      ]
    },
    "theme": {
      "enum": [
        "light",
        "dark",
        "paper"
      ]
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voteWeighting",
        "shareSnapshotDate",
        "scoring"
      ],
      "properties": {
        "voteWeighting": {
          "enum": [
            "equal",
            "shares"
          ]
        },
        "shareSnapshotDate": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "scoring": {
          "const": "heuristic-v1"
        },
        "showAuthors": {
          "type": "boolean"
        },
        "assessmentWeighting": {
          "enum": [
            "structural",
            "equal",
            "shares"
          ],
          "description": "Collective assessment aggregation. Omitted in older v5 files means structural (legacy)."
        }
      }
    },
    "users": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/user"
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "votes": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/vote"
      }
    },
    "ballots": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/ballot"
      }
    },
    "createdAt": {
      "type": "string",
      "maxLength": 50
    },
    "updatedAt": {
      "type": "string",
      "maxLength": 50
    },
    "comments": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/comment"
      }
    },
    "links": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "edgeAssessments": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/edgeAssessment"
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fourWayOffsets"
      ],
      "properties": {
        "fourWayOffsets": {
          "type": "object",
          "maxProperties": 1000,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "y": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              }
            }
          }
        }
      }
    },
    "votingRound": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "status",
            "anonymous",
            "hideResults",
            "weighting",
            "weightByUser",
            "optionIds",
            "openedAt",
            "closedAt"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "status": {
              "enum": [
                "open",
                "closed"
              ]
            },
            "anonymous": {
              "type": "boolean"
            },
            "hideResults": {
              "type": "boolean"
            },
            "weighting": {
              "enum": [
                "equal",
                "shares"
              ]
            },
            "weightByUser": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000000000.0
              }
            },
            "optionIds": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "minItems": 2,
              "maxItems": 1000
            },
            "openedAt": {
              "type": "string",
              "maxLength": 50
            },
            "closedAt": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 50
            }
          }
        }
      ]
    },
    "voteAudit": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "roundId",
          "action",
          "userId",
          "at"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "roundId": {
            "$ref": "#/$defs/id"
          },
          "action": {
            "enum": [
              "open",
              "cast",
              "update",
              "retract",
              "close"
            ]
          },
          "userId": {
            "$ref": "#/$defs/id"
          },
          "optionId": {
            "$ref": "#/$defs/id"
          },
          "at": {
            "type": "string",
            "maxLength": 50
          }
        }
      }
    },
    "voteHistory": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "round",
          "ballots",
          "audit",
          "titleByOption"
        ],
        "properties": {
          "round": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "anonymous",
              "hideResults",
              "weighting",
              "weightByUser",
              "optionIds",
              "openedAt",
              "closedAt"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "status": {
                "const": "closed"
              },
              "anonymous": {
                "type": "boolean"
              },
              "hideResults": {
                "type": "boolean"
              },
              "weighting": {
                "enum": [
                  "equal",
                  "shares"
                ]
              },
              "weightByUser": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000.0
                }
              },
              "optionIds": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "minItems": 2,
                "maxItems": 1000
              },
              "openedAt": {
                "type": "string",
                "maxLength": 50
              },
              "closedAt": {
                "type": "string",
                "maxLength": 50
              }
            }
          },
          "ballots": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "$ref": "#/$defs/ballot"
            }
          },
          "audit": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "roundId",
                "action",
                "userId",
                "at"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "roundId": {
                  "$ref": "#/$defs/id"
                },
                "action": {
                  "enum": [
                    "open",
                    "cast",
                    "update",
                    "retract",
                    "close"
                  ]
                },
                "userId": {
                  "$ref": "#/$defs/id"
                },
                "optionId": {
                  "$ref": "#/$defs/id"
                },
                "at": {
                  "type": "string",
                  "maxLength": 50
                }
              }
            }
          },
          "titleByOption": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 200
            }
          }
        }
      }
    },
    "sharedReasons": {
      "type": "array",
      "maxItems": 200,
      "description": "Project-wide locked reason templates; explicit primary leaf uses reference their id. No extra score or rating dimension.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "confidence",
          "influence"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "$ref": "#/$defs/title"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "influence": {
            "type": "number",
            "minimum": -5,
            "maximum": 5,
            "multipleOf": 0.5
          }
        }
      }
    },
    "reasonConcepts": {
      "type": "array",
      "maxItems": 200,
      "description": "Optional reusable semantic identities. Each linked primary claim remains a separately rated contextual occurrence; concept itself has no p/w or numeric contribution.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "semanticType"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "$ref": "#/$defs/title"
          },
          "semanticType": {
            "enum": [
              "fact",
              "assumption",
              "value"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "shares",
        "role"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "shares": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "role": {
          "enum": [
            "owner",
            "editor",
            "viewer"
          ]
        },
        "profileKind": {
          "enum": [
            "human",
            "ai"
          ]
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parentId",
        "relation",
        "kind",
        "title",
        "details",
        "confidence",
        "impact",
        "collapsed",
        "position",
        "createdBy"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "parentId": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "relation": {
          "enum": [
            "root",
            "support",
            "oppose",
            "neutral",
            "option",
            "group"
          ]
        },
        "kind": {
          "enum": [
            "claim",
            "option",
            "decision",
            "group"
          ]
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "details": {
          "type": "string",
          "maxLength": 5000
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "impact": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "collapsed": {
          "type": "boolean"
        },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": -1000000,
              "maximum": 1000000
            },
            "y": {
              "type": "number",
              "minimum": -1000000,
              "maximum": 1000000
            }
          }
        },
        "createdBy": {
          "$ref": "#/$defs/id"
        },
        "semanticType": {
          "enum": [
            "unspecified",
            "fact",
            "value",
            "assumption",
            "constraint",
            "prerequisite"
          ]
        },
        "constraintStatus": {
          "enum": [
            "unknown",
            "met",
            "unmet"
          ]
        },
        "sources": {
          "type": "array",
          "maxItems": 25,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "note"
            ],
            "properties": {
              "url": {
                "type": "string",
                "minLength": 8,
                "maxLength": 1000,
                "pattern": "^https?://"
              },
              "note": {
                "type": "string",
                "maxLength": 500
              }
            }
          }
        },
        "authorVisibility": {
          "enum": [
            "named",
            "anonymous"
          ]
        },
        "sharedReasonId": {
          "$ref": "#/$defs/id"
        },
        "reasonConceptId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "vote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nodeId",
        "userId",
        "confidence",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "nodeId": {
          "$ref": "#/$defs/id"
        },
        "userId": {
          "$ref": "#/$defs/id"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        }
      }
    },
    "ballot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "optionId",
        "userId",
        "preference",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "optionId": {
          "$ref": "#/$defs/id"
        },
        "userId": {
          "$ref": "#/$defs/id"
        },
        "preference": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        }
      }
    },
    "comment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nodeId",
        "body",
        "authorName",
        "createdAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "nodeId": {
          "$ref": "#/$defs/id"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "authorName": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "authorId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceId",
        "targetId",
        "relation",
        "impact"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "sourceId": {
          "$ref": "#/$defs/id"
        },
        "targetId": {
          "$ref": "#/$defs/id"
        },
        "relation": {
          "enum": [
            "support",
            "oppose"
          ]
        },
        "impact": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "edgeAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "userId",
        "subjectType",
        "subjectId",
        "influence",
        "fingerprint",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "userId": {
          "$ref": "#/$defs/id"
        },
        "subjectType": {
          "enum": [
            "primary",
            "secondary"
          ]
        },
        "subjectId": {
          "$ref": "#/$defs/id"
        },
        "influence": {
          "type": "number",
          "minimum": -5,
          "maximum": 5,
          "multipleOf": 0.5
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 850
        },
        "updatedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        }
      }
    }
  }
}
