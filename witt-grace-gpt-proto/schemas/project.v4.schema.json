{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:witt:project:v4",
  "title": "WITT project interchange schema v4 (local assessor profiles)",
  "description": "Versioned WITT claim tree with optional secondary relations and separate per-user credence and per-relation signed impact. Local assessor IDs are not authenticated identities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "mode",
    "theme",
    "settings",
    "users",
    "nodes",
    "comments",
    "votes",
    "ballots",
    "createdAt",
    "updatedAt",
    "links",
    "edgeAssessments"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "$ref": "#/$defs/title"
    },
    "mode": {
      "enum": [
        "argument",
        "decision"
      ]
    },
    "theme": {
      "enum": [
        "light",
        "dark",
        "paper"
      ]
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voteWeighting",
        "shareSnapshotDate",
        "scoring"
      ],
      "properties": {
        "voteWeighting": {
          "enum": [
            "equal",
            "shares"
          ]
        },
        "shareSnapshotDate": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "scoring": {
          "const": "heuristic-v1"
        }
      }
    },
    "users": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/user"
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "votes": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/vote"
      }
    },
    "ballots": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/ballot"
      }
    },
    "createdAt": {
      "type": "string",
      "maxLength": 50
    },
    "updatedAt": {
      "type": "string",
      "maxLength": 50
    },
    "comments": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/comment"
      }
    },
    "links": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "edgeAssessments": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/edgeAssessment"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "shares",
        "role"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "shares": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "role": {
          "enum": [
            "owner",
            "editor",
            "viewer"
          ]
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parentId",
        "relation",
        "kind",
        "title",
        "details",
        "confidence",
        "impact",
        "collapsed",
        "position",
        "createdBy"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "parentId": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "relation": {
          "enum": [
            "root",
            "support",
            "oppose",
            "option"
          ]
        },
        "kind": {
          "enum": [
            "claim",
            "option",
            "decision"
          ]
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "details": {
          "type": "string",
          "maxLength": 5000
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "impact": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "collapsed": {
          "type": "boolean"
        },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": -1000000,
              "maximum": 1000000
            },
            "y": {
              "type": "number",
              "minimum": -1000000,
              "maximum": 1000000
            }
          }
        },
        "createdBy": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "vote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nodeId",
        "userId",
        "confidence",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "nodeId": {
          "$ref": "#/$defs/id"
        },
        "userId": {
          "$ref": "#/$defs/id"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        }
      }
    },
    "ballot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "optionId",
        "userId",
        "preference",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "optionId": {
          "$ref": "#/$defs/id"
        },
        "userId": {
          "$ref": "#/$defs/id"
        },
        "preference": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        }
      }
    },
    "comment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nodeId",
        "body",
        "authorName",
        "createdAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "nodeId": {
          "$ref": "#/$defs/id"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "authorName": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceId",
        "targetId",
        "relation",
        "impact"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "sourceId": {
          "$ref": "#/$defs/id"
        },
        "targetId": {
          "$ref": "#/$defs/id"
        },
        "relation": {
          "enum": [
            "support",
            "oppose"
          ]
        },
        "impact": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "edgeAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "userId",
        "subjectType",
        "subjectId",
        "influence",
        "fingerprint",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "userId": {
          "$ref": "#/$defs/id"
        },
        "subjectType": {
          "enum": [
            "primary",
            "secondary"
          ]
        },
        "subjectId": {
          "$ref": "#/$defs/id"
        },
        "influence": {
          "type": "number",
          "minimum": -5,
          "maximum": 5,
          "multipleOf": 0.5
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 850
        },
        "updatedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        }
      }
    }
  }
}
