{
  "name": "witt-grace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WITT: a local-first argument map and decision workbench for the GRACE method. Rebuild of the dev32 prototype kept in witt-grace-gpt-proto/.",
  "engines": {
    "node": ">=22.18 <27"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "golden": "node scripts/golden-from-proto.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/check-docs.mjs && node scripts/check-spec-lock.mjs && npm run lint && npm run typecheck && npm run format:check && npm test",
    "proto:check": "npm --prefix witt-grace-gpt-proto run check",
    "proto:build": "npm --prefix witt-grace-gpt-proto run build && cd witt-grace-gpt-proto && node tools/verify-pages-build.cjs",
    "proto:dev": "npm --prefix witt-grace-gpt-proto run dev",
    "i18n": "node scripts/generate-locales.ts",
    "build": "vite build",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:local": "npm run build && playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@trystero-p2p/nostr": "0.26.0",
    "@trystero-p2p/ws-relay": "0.26.0"
  }
}
